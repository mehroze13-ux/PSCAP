# ── Database ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=amazon_reviews

# ── Google Gemini (free — get key at aistudio.google.com) ──────────────────────
GEMINI_API_KEY=AIza...

# ── Scraper ─────────────────────────────────────────────────────────────────────
# Path to chromedriver — leave blank to use system default
CHROMEDRIVER_PATH=

# Path to a Chrome profile already logged into Amazon India
# Leave blank to use default path (./chrome-profile)
CHROME_PROFILE=

# Seconds to pause between products (prevents rate-limiting)
SCRAPER_PAUSE=8

# To scrape only specific ASINs, comma-separate them here (leave blank = scrape all)
# Example: SCRAPE_ASINS=B0XXXXXXXX,B0YYYYYYYY
SCRAPE_ASINS=

# Set to true to re-tag all reviews (wipes existing tags)
RETAG_ALL_REVIEWS_ON_PIPELINE=false
